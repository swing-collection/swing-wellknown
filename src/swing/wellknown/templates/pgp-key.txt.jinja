# {{ site.name_long }}
{%- endif %}

{%- if pgp is defined and pgp.key is defined %}
-----BEGIN PGP PUBLIC KEY BLOCK-----

{{ pgp.key }}
-----END PGP PUBLIC KEY BLOCK-----
{%- else %}
# No PGP key has been configured.
#
# To add a PGP key, set the 'pgp' context variable with:
