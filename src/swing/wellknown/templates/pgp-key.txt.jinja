#     "key": "<base64 encoded public key>",
#     "fingerprint": "<key fingerprint>",
#     "key_id": "<key id>",
#     "expires": "<expiry date>"
# }
{%- endif %}

{%- if pgp is defined %}

# =============================================================================
# Key Information
# =============================================================================

{%- if pgp.fingerprint is defined %}
Fingerprint: {{ pgp.fingerprint }}
