{%- endif %}
{%- if pgp.expires is defined %}
Expires: {{ pgp.expires }}
{%- endif %}
{%- if pgp.email is defined %}
Email: {{ pgp.email }}
{%- elif site_contact is defined and site_contact.email is defined %}
Email: {{ site_contact.email }}
{%- endif %}

{%- if pgp.keyserver is defined %}

# =============================================================================
# Key Server
# =============================================================================

{{ pgp.keyserver }}
{%- endif %}
{%- endif %}
